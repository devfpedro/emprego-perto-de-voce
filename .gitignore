# =========================================
# GERAL
# =========================================

# Backups do banco de dados (nunca versionar)
*.backup

# Variaveis de ambiente (segredos e senhas)
.env
.env.*
!.env.example

# Sistema operacional
.DS_Store

# Logs
*.log

# =========================================
# BACKEND (Python / Flask)
# =========================================

# Ambiente virtual
venv/
env/
ENV/
.venv/

# Cache do Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Editor e IDEs
/backend/.vscode/
/backend/.idea/
*.swp
*.swo

